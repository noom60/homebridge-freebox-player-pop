{
  "pluginAlias": "FreeboxPlayerPop",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Allume et éteint un Freebox Player POP depuis HomeKit. Appaire chaque Player avec le bouton « Appairer » ci-dessus, puis ajoute-le dans la liste. — Turns a Freebox Player POP on and off from HomeKit. Pair each Player with the « Pair » button above, then add it to the list.",
  "schema": {
    "type": "object",
    "properties": {
      "players": {
        "title": "Players",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Nom dans HomeKit / HomeKit name",
              "type": "string",
              "default": "Freebox Player",
              "required": true
            },
            "host": {
              "title": "Adresse IP du Player / Player IP address",
              "type": "string",
              "format": "ipv4",
              "placeholder": "192.168.1.37",
              "required": true
            },
            "debug": {
              "title": "Journal détaillé / Verbose log",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}
